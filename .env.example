# Copy to .env and fill in. Never commit the real file.

# Required. Long random bearer token for the API.
# Generate with: openssl rand -hex 32
TENON_API_TOKEN=

# Public hostname Caddy serves. localhost uses Caddy's internal CA.
TENON_DOMAIN=localhost

# Optional. GitHub webhook HMAC secret; generate with: openssl rand -hex 32
TENON_WEBHOOK_SECRET=

# GitHub App identity (T10a). The key file is mounted read-only from ./secrets.
TENON_GITHUB_APP_ID=
TENON_GITHUB_APP_INSTALLATION_ID=
TENON_GITHUB_APP_PRIVATE_KEY=/secrets/app.pem
TENON_GITHUB_API_URL=https://api.github.com

# Commit identity used for the branches and commits the service opens.
GIT_AUTHOR_NAME=Tenon Service
GIT_AUTHOR_EMAIL=tenon@example.com
GIT_COMMITTER_NAME=Tenon Service
GIT_COMMITTER_EMAIL=tenon@example.com
